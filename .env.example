# Environment variables for Mate production deployment

# Application
DEBUG=False
HOST=0.0.0.0
PORT=8080

# Security
SECRET_KEY=change-this-in-production

# Session
SESSION_COOKIE_NAME=mate_sid
SESSION_COOKIE_MAX_AGE=86400
SESSION_COOKIE_SAME_SITE=Lax

# Tone
TONE_DEFAULT=amable

# quotas
DAILY_TOKEN_BUDGET=50000

# Redis (shared arch-redis, empty = in-memory fallback)
REDIS_URL=

# iCalendar
ICS_TOKEN_PREFIX=mate:

# Paths
DATABASE_PATH=/data/mate.db

# LLM (Gemini Native API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_S=20